# The site's settings for the scripts here (dp-*.sh, through lib-keycloak.sh):
# rendered by make configure from inventory/group_vars/all/site.yml and its
# derived variables. A variable already set in the environment wins.
: "${KEYCLOAK_ISSUER:=https://keycloak.data.example.org/realms/data-platform}"
: "${METACATALOG_URL:=https://metacatalog.data.example.org}"
: "${TRINO_URL:=https://trino.data.example.org}"
: "${S3_ENDPOINT:=https://s3.example.org}"
: "${S3_REGION:=us-east-1}"
: "${S3_BUCKET:=dataplatform}"
: "${ROLE_ARN_PREFIX:=arn:aws:iam::RGW00000000000000001:role/}"
: "${USER_ROLE_PREFIX:=usr-}"
: "${GROUP_ROLE_PREFIX:=grp-}"
# the prefix of the platform's label keys (<it>/user on a Spark job's objects)
: "${LABEL_DOMAIN:=data.example.org}"
