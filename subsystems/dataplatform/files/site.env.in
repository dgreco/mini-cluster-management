# The site's settings for the scripts here (dp-*.sh, through lib-keycloak.sh):
# rendered by make configure from inventory/group_vars/all/site.yml and its
# derived variables. A variable already set in the environment wins.
: "${KEYCLOAK_ISSUER:=<%= dataplatform_keycloak_issuer %>}"
: "${METACATALOG_URL:=https://metacatalog.<%= dataplatform_domain %>}"
: "${TRINO_URL:=https://trino.<%= dataplatform_domain %>}"
: "${S3_ENDPOINT:=<%= dataplatform_s3_endpoint %>}"
: "${S3_REGION:=<%= dataplatform_s3_region %>}"
: "${S3_BUCKET:=<%= dataplatform_bucket %>}"
: "${ROLE_ARN_PREFIX:=arn:aws:iam::<%= dataplatform_rgw_account_id %>:role/}"
: "${USER_ROLE_PREFIX:=<%= dataplatform_iam_user_role_prefix %>}"
: "${GROUP_ROLE_PREFIX:=<%= dataplatform_iam_group_role_prefix %>}"
# the prefix of the platform's label keys (<it>/user on a Spark job's objects)
: "${LABEL_DOMAIN:=<%= dataplatform_domain %>}"
