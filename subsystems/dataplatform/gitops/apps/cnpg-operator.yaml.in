# CloudNativePG operator 1.30.1. The operator writes its webhooks' CA at
# runtime, so the caBundle is not compared.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cnpg-operator
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "-4"
spec:
  project: dataplatform
  sources:
    - repoURL: https://cloudnative-pg.github.io/charts
      chart: cloudnative-pg
      targetRevision: "0.29.1"
      helm:
        releaseName: cnpg-operator
        valueFiles:
          - $values/subsystems/dataplatform/gitops/helm-values/cnpg-operator-values.yaml
    - repoURL: <%= dataplatform_git_repo %>
      targetRevision: <%= dataplatform_git_revision %>
      ref: values
  destination:
    server: https://kubernetes.default.svc
    namespace: operators
  ignoreDifferences:
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
      # only what is written at runtime. With RespectIgnoreDifferences Argo CD
      # copies the ignored live fields into the apply: never .spec (a chart
      # upgrade would keep the old schema), never the whole .metadata
      # (managedFields is refused)
      jqPathExpressions:
        - .status
        - .metadata.labels
        - .metadata.annotations
    - group: admissionregistration.k8s.io
      kind: ValidatingWebhookConfiguration
      jqPathExpressions:
        - .webhooks[]?.clientConfig.caBundle
    - group: admissionregistration.k8s.io
      kind: MutatingWebhookConfiguration
      jqPathExpressions:
        - .webhooks[]?.clientConfig.caBundle
  syncPolicy:
    # No finalizer and no prune: deleting this Application, or a chart that
  # drops a CRD, must not delete the custom resources with it
    automated:
      prune: false
      selfHeal: true
    syncOptions:
      - ServerSideApply=true
      - SkipDryRunOnMissingResource=true
      - RespectIgnoreDifferences=true
    retry:
      limit: 10
      backoff:
        duration: 30s
        maxDuration: 5m
        factor: 2
