apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: core-openbao-gateway
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: dataplatform
  source:
    repoURL: <%= dataplatform_git_repo %>
    targetRevision: <%= dataplatform_git_revision %>
    path: subsystems/dataplatform/gitops/manifests/core/openbao-gateway
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - SkipDryRunOnMissingResource=true
    retry:
      limit: 10
      backoff:
        duration: 30s
        maxDuration: 5m
        factor: 2
