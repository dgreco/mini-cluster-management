apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: governance-hive-metastore
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "0"
spec:
  project: dataplatform
  source:
    repoURL: <%= dataplatform_git_repo %>
    targetRevision: <%= dataplatform_git_revision %>
    path: subsystems/dataplatform/gitops/manifests/governance/hive-metastore
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    # No finalizer and no prune: deleting or renaming this Application in Git
  # must not take the data with it (the database cluster and its volumes)
    automated:
      prune: false
      selfHeal: true
    syncOptions:
      - SkipDryRunOnMissingResource=true
    retry:
      limit: 10
      backoff:
        duration: 30s
        maxDuration: 5m
        factor: 2
