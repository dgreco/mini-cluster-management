apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: governance-iam-access
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "1"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: dataplatform
  source:
    repoURL: <%= dataplatform_git_repo %>
    targetRevision: <%= dataplatform_git_revision %>
    path: subsystems/dataplatform/gitops/iam
  destination:
    server: https://kubernetes.default.svc
  # the record of grants: Argo CD creates it, Meta Catalog's scripts write it;
  # the grants as the Open Policy Agent reads them: iam-sync writes them
  ignoreDifferences:
    - kind: ConfigMap
      name: metacatalog-grants
      jsonPointers: [/data]
    - kind: ConfigMap
      name: trino-grants
      jsonPointers: [/data]
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - SkipDryRunOnMissingResource=true
      - RespectIgnoreDifferences=true
    retry:
      limit: 10
      backoff:
        duration: 30s
        maxDuration: 5m
        factor: 2
