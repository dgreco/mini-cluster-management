apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: governance-metacatalog
  namespace: argocd
  annotations:
    # last wave: it needs the realm's client, and the root app waits for each
    # wave to be healthy, so a slow start here holds back nothing else
    argocd.argoproj.io/sync-wave: "3"
spec:
  project: dataplatform
  source:
    repoURL: <%= dataplatform_git_repo %>
    targetRevision: <%= dataplatform_git_revision %>
    path: subsystems/dataplatform/gitops/manifests/governance/metacatalog
  destination:
    server: https://kubernetes.default.svc
  # The record of grants (metacatalog-grants.yaml): Argo CD creates it, the
  # provisioning scripts own its data
  ignoreDifferences:
    - kind: ConfigMap
      name: metacatalog-grants
      jsonPointers: [/data]
  syncPolicy:
    # No finalizer and no prune: deleting or renaming this Application in Git
    # must not take the data with it (the database cluster and its volumes)
    automated:
      prune: false
      selfHeal: true
    syncOptions:
      - SkipDryRunOnMissingResource=true
      - RespectIgnoreDifferences=true
    retry:
      limit: 10
      backoff:
        duration: 30s
        maxDuration: 5m
        factor: 2
