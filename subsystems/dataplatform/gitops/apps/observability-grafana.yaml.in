apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: observability-grafana
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "1"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: dataplatform
  sources:
    - repoURL: https://grafana-community.github.io/helm-charts
      chart: grafana
      targetRevision: "13.2.6"
      helm:
        releaseName: grafana
        valueFiles:
          - $values/subsystems/dataplatform/gitops/helm-values/grafana-values.yaml
    - repoURL: <%= dataplatform_git_repo %>
      targetRevision: <%= dataplatform_git_revision %>
      ref: values
      path: subsystems/dataplatform/gitops/manifests/observability/grafana
  destination:
    server: https://kubernetes.default.svc
    namespace: observability
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - ServerSideApply=true
      - SkipDryRunOnMissingResource=true
    retry:
      limit: 10
      backoff:
        duration: 30s
        maxDuration: 5m
        factor: 2
