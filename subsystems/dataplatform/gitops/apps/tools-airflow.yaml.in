# Apache Airflow (gitops/manifests/tools/airflow): Stackable's AirflowCluster
# with its PostgreSQL, behind Keycloak, at https://airflow.<%= dataplatform_domain %>; the DAGs
# come from subsystems/dataplatform/examples/lakehouse/dags through git-sync.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: tools-airflow
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "2"
spec:
  project: dataplatform
  source:
    repoURL: <%= dataplatform_git_repo %>
    targetRevision: <%= dataplatform_git_revision %>
    path: subsystems/dataplatform/gitops/manifests/tools/airflow
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    # No finalizer and no prune: deleting or renaming this Application in Git
    # must not take Airflow's database with it
    automated:
      prune: false
      selfHeal: true
    syncOptions:
      - SkipDryRunOnMissingResource=true
    retry:
      limit: 10
      backoff:
        duration: 30s
        maxDuration: 5m
        factor: 2
