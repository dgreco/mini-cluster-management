# https://argocd.<%= dataplatform_domain %> -> argocd-server (plain HTTP: TLS ends at
# the Gateway, server.insecure in bootstrap/argocd-values.yaml).
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd
spec:
  parentRefs:
    - name: main-gateway
      namespace: core
      sectionName: argocd-https
  hostnames:
    - argocd.<%= dataplatform_domain %>
  rules:
    - backendRefs:
        - name: argocd-server
          port: 80
