# iam-sync (iam_sync.py): Keycloak groups -> Trino's groups file, S3 security
# mapping and access rules (ConfigMap compute/trino-iam), the Spark jobs'
# RoleBinding (compute), from Keycloak, the platform's settings (ConfigMap
# iam-access: access.yaml) and the record of grants Meta Catalog writes
# (ConfigMap metacatalog-grants, read through the API). Python standard
# library only, on the stock Python image.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: iam-sync
  namespace: governance
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: iam-sync
  template:
    metadata:
      labels:
        app.kubernetes.io/name: iam-sync
    spec:
      serviceAccountName: iam-sync
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: iam-sync
          # pinned by digest: a moving tag would change the program's runtime under it
          image: docker.io/library/python:3.13-alpine@sha256:79e7a9b9ff1cbceff819f856fb374477792a5967759d94df266de7b7b4120e6f
          command: [python3, -u, /app/iam_sync.py]
          env:
            # the Service, not the public name: the Gateway redirects the admin API away
            - name: KEYCLOAK_URL
              value: http://keycloak-service.governance.svc:8080
            - name: KEYCLOAK_REALM
              value: <%= dataplatform_keycloak_realm %>
            - name: KEYCLOAK_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: iam-sync-keycloak
                  key: client-secret
            - name: TRINO_NAMESPACE
              value: compute
            - name: ACCESS_FILE
              value: /etc/iam-sync/access/access.yaml
            - name: ROLE_ARN_PREFIX
              value: arn:aws:iam::<%= dataplatform_rgw_account_id %>:role/
            # the label on what it writes: <it>/managed-by
            - name: LABEL_DOMAIN
              value: <%= dataplatform_domain %>
          resources:
            requests: {cpu: 10m, memory: 48Mi}
            limits: {memory: 128Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - {name: script, mountPath: /app, readOnly: true}
            - {name: access, mountPath: /etc/iam-sync/access, readOnly: true}
      volumes:
        - name: script
          configMap:
            name: iam-sync-script
        # access.yaml
        - name: access
          configMap:
            name: iam-access
