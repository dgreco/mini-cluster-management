{
  "ServerURL": "<%= dataplatform_directory_url %>",
  "useTLS": "no",
  "followReferrals": "false",
  "pagedResults": "true",
  "Admins": "",
  "defaultLanguage": "en_GB.utf8",
  "scriptPath": "",
  "scriptServer": "",
  "scriptRights": "750",
  "serverDisplayName": "Directory of the data platform",
  "activeTypes": "user,group",
  "accessLevel": "100",
  "loginMethod": "search",
  "loginSearchSuffix": "OU=<%= dataplatform_directory_people_ou %>,<%= dataplatform_directory_base_dn %>",
  "loginSearchFilter": "(&(sAMAccountName=%USER%)(|<% for g in dataplatform_iam_admin_groups %>(memberOf=CN=<%= g %>,OU=<%= dataplatform_directory_groups_ou %>,<%= dataplatform_directory_base_dn %>)<% endfor %>))",
  "searchLimit": "0",
  "lamProMailFrom": "noreply@example.com",
  "lamProMailReplyTo": "",
  "lamProMailSubject": "Your password was reset",
  "lamProMailText": "Dear @@givenName@@ @@sn@@,+::++::+your password was reset to: @@newPassword@@+::++::++::+Best regards+::++::+deskside support+::+",
  "lamProMailIsHTML": "false",
  "lamProMailAllowAlternateAddress": "true",
  "httpAuthentication": "false",
  "loginSearchDN": "CN=<%= dataplatform_directory_bind_user %>,OU=<%= dataplatform_directory_services_ou %>,<%= dataplatform_directory_base_dn %>",
  "loginSearchPassword": "",
  "timeZone": "UTC",
  "jobsBindUser": null,
  "jobsBindPassword": null,
  "jobsDatabase": null,
  "jobsDBHost": null,
  "jobsDBPort": null,
  "jobsDBUser": null,
  "jobsDBPassword": null,
  "jobsDBName": null,
  "pwdResetAllowSpecificPassword": "true",
  "pwdResetAllowScreenPassword": "true",
  "pwdResetForcePasswordChange": "false",
  "pwdResetDefaultPasswordOutput": "2",
  "scriptUserName": "",
  "scriptSSHKey": "",
  "scriptSSHKeyPassword": "",
  "twoFactorAuthentication": "none",
  "twoFactorAuthenticationURL": "https://localhost",
  "twoFactorAuthenticationInsecure": false,
  "twoFactorAuthenticationLabel": "",
  "twoFactorAuthenticationOptional": false,
  "twoFactorAuthenticationCaption": "",
  "twoFactorAuthenticationClientId": "",
  "twoFactorAuthenticationSecretKey": "",
  "twoFactorAuthenticationDomain": "",
  "twoFactorAuthenticationAttribute": "uid",
  "twoFactorAllowToRememberDevice": "false",
  "twoFactorRememberDeviceDuration": "28800",
  "referentialIntegrityOverlay": "false",
  "hidePasswordPromptForExpiredPasswords": "false",
  "hideDnPart": "",
  "pwdPolicyMinLength": "<%= dataplatform_directory_min_password_length %>",
  "pwdPolicyMinLowercase": "1",
  "pwdPolicyMinUppercase": "1",
  "pwdPolicyMinNumeric": "1",
  "pwdPolicyMinSymbolic": "",
  "typeSettings": {
    "suffix_user": "OU=<%= dataplatform_directory_people_ou %>,<%= dataplatform_directory_base_dn %>",
    "attr_user": "#sAMAccountName;#givenName;#sn;#mail",
    "modules_user": "windowsUser",
    "suffix_group": "OU=<%= dataplatform_directory_groups_ou %>,<%= dataplatform_directory_base_dn %>",
    "attr_group": "#cn;#member;#description",
    "modules_group": "windowsGroup"
  },
  "moduleSettings": {
    "windowsGroup_hidemail": [
      "false"
    ],
    "windowsGroup_hidemanagedBy": [
      "true"
    ],
    "windowsGroup_hidemsSFU30Name": [
      "true"
    ],
    "windowsGroup_hidemsSFU30NisDomain": [
      "true"
    ],
    "windowsGroup_hideotherMailbox": [
      "false"
    ],
    "windowsUser_domains": [
      "<%= dataplatform_directory_domain %>"
    ],
    "windowsUser_hideRequireSmartcard": [
      "true"
    ],
    "windowsUser_hideWorkstations": [
      "true"
    ],
    "windowsUser_hidehomeDirectory": [
      "true"
    ],
    "windowsUser_hidehomeDrive": [
      "true"
    ],
    "windowsUser_hidelogonHours": [
      "true"
    ],
    "windowsUser_hidemsSFU30Name": [
      "true"
    ],
    "windowsUser_hidemsSFU30NisDomain": [
      "true"
    ],
    "windowsUser_hideprofilePath": [
      "true"
    ],
    "windowsUser_hidesAMAccountName": [
      "true"
    ],
    "windowsUser_hidescriptPath": [
      "true"
    ]
  },
  "toolSettings": {
    "treeViewSuffix": "<%= dataplatform_directory_base_dn %>",
    "tool_hide_toolServerInformation": "false",
    "tool_hide_toolFileUpload": "false",
    "tool_hide_toolMultiEdit": "false",
    "tool_hide_toolPDFEditor": "false",
    "tool_hide_toolOUEditor": "true",
    "tool_hide_toolProfileEditor": "true",
    "tool_hide_ImportExport": "false",
    "tool_hide_toolWebauthn": "false",
    "tool_hide_toolSchemaBrowser": "false",
    "tool_hide_TreeViewTool": "false",
    "tool_hide_toolTests": "false"
  },
  "jobSettings": []
}
