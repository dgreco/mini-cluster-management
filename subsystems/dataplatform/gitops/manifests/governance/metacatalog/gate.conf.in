# The gate between oauth2-proxy and Meta Catalog (metacatalog-proxy.yaml).
# Authorizing and rejecting a lakehouse give and take data access (they write
# the record of grants and Ceph's roles: provisioning/lib-grants.sh), so only
# members of <%= site_admin_group %> may, in the API and in the UI; every other
# request passes. Meta Catalog itself has no roles.
#
# oauth2-proxy sets X-Forwarded-Groups from the session or bearer token it
# checked (one header line per group, Keycloak's roles among them as
# role:<name>), and drops one a client sent; nginx joins the lines with ", ".
# This nginx listens on the pod's loopback only, so nothing else reaches it. The paths match without a final
# anchor and in any case: nginx compares the decoded, normalised path
# (%61uthorize, //, /./), and Spring would still route
# /authorize;x or /authorize/ to the same handler.
pid /tmp/nginx.pid;
worker_processes 1;
error_log /dev/stderr warn;

events {
  worker_connections 256;
}

http {
  # oauth2-proxy logs every request with its user
  access_log off;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  client_max_body_size 64m;
  # a synchronous provision or unprovision takes minutes
  proxy_read_timeout 600s;
  proxy_send_timeout 600s;
  proxy_http_version 1.1;
  # the browser's host: Meta Catalog builds its login redirect from it and
  # from the X-Forwarded-* headers, which pass unchanged
  proxy_set_header Host $http_host;
  proxy_set_header Connection "";

  map $http_x_forwarded_groups $platform_admin {
    default 0;
    "~(^|,)\s*<%= site_admin_group %>\s*(,|$)" 1;
  }

  upstream metacatalog {
    server metacatalog.governance.svc:80;
    keepalive 8;
  }

  server {
    listen 127.0.0.1:8081;

    # API: POST /metacatalog/v1/aggregate/{id}/authorize|reject
    location ~* ^/metacatalog/v1/aggregate/.*/(authorize|reject) {
      if ($platform_admin = 0) {
        return 403 "Only members of <%= site_admin_group %> may authorize or reject: data access changes with it.\n";
      }
      proxy_pass http://metacatalog;
    }

    # UI: POST /ui/instances/{id}/procedure/authorize|reject
    location ~* ^/ui/instances/.*/procedure/+(authorize|reject) {
      if ($platform_admin = 0) {
        return 403 "Only members of <%= site_admin_group %> may authorize or reject: data access changes with it.\n";
      }
      proxy_pass http://metacatalog;
    }

    location / {
      proxy_pass http://metacatalog;
    }
  }
}
