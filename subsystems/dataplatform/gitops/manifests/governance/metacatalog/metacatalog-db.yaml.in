# Meta Catalog's database. The application owns the schema (Flyway
# migrations at its start), so the bootstrap only makes the database and its
# owner.
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: metacatalog-db
spec:
  instances: 2
  storage:
    storageClass: <%= dataplatform_storage_class %>
    size: 2Gi
  bootstrap:
    initdb:
      database: metacatalog
      owner: metacatalog
      secret:
        name: metacatalog-db-owner
  # Continuous WAL archiving and the nightly base backups go through the
  # Barman Cloud plugin to the ObjectStore metacatalog-db (metacatalog-db-objectstore.yaml):
  # s3://<%= site_backup_bucket %>/cnpg/metacatalog-db/metacatalog-db/, with the backup key.
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: true
      parameters:
        barmanObjectName: metacatalog-db
  resources:
    requests: {cpu: 50m, memory: 256Mi}
    limits: {memory: 512Mi}
  inheritedMetadata:
    annotations:
      prometheus.io/scrape: "true"
      prometheus.io/port: "9187"
