# oauth2-proxy in front of Meta Catalog: only members of <%= site_admin_group %> and
# <%= site_engineer_group %> reach it, in the browser and through the API. Meta Catalog
# itself checks only that a caller is logged in (it has no roles), and it
# takes any access token of the realm; every lakehouse is created, changed
# and dropped there (provision, unprovision), so the gate is here.
#
# - Browser: a Keycloak login with the client metacatalog (the groups claim,
#   checked at login), then Meta Catalog's own login with the same client,
#   which the Keycloak session answers at once.
# - API: a bearer token is checked here (signature, issuer, the audience
#   metacatalog, which the clients data-cli and smoke-test add, and the
#   groups) and passed on unchanged.
# - Then the gate (gate.conf, the container gate on the pod's loopback):
#   authorize and reject, which give and take data access, only for members
#   of <%= site_admin_group %>, from the groups oauth2-proxy passes on.
# Probes go to the application's pod directly; nothing else reaches its
# Service from outside governance (namespaces/network-policies.yaml).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: metacatalog-proxy
  labels:
    app.kubernetes.io/name: metacatalog-proxy
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: metacatalog-proxy
  template:
    metadata:
      labels:
        app.kubernetes.io/name: metacatalog-proxy
      annotations:
        # its metrics go through the OTel cluster collector like everything else
        prometheus.io/scrape: "true"
        prometheus.io/port: "44180"
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: oauth2-proxy
          image: quay.io/oauth2-proxy/oauth2-proxy:v7.15.4
          args:
            - --provider=keycloak-oidc
            - --oidc-issuer-url=https://keycloak.<%= dataplatform_domain %>/realms/<%= dataplatform_keycloak_realm %>
            - --client-id=metacatalog
            - --code-challenge-method=S256
            - --scope=openid profile email
            - --allowed-group=<%= site_admin_group %>
            - --allowed-group=<%= site_engineer_group %>
            - --email-domain=*
            - --redirect-url=https://metacatalog.<%= dataplatform_domain %>/oauth2/callback
            # API calls: a bearer token of the realm with the audience metacatalog
            - --skip-jwt-bearer-tokens=true
            - --extra-jwt-issuers=https://keycloak.<%= dataplatform_domain %>/realms/<%= dataplatform_keycloak_realm %>=metacatalog
            # through the gate (below), never to Meta Catalog directly
            - --upstream=http://127.0.0.1:8081/
            # X-Forwarded-Groups (and -User, -Email) for the gate, from the
            # checked session or token; one a client sent is dropped
            - --pass-user-headers=true
            # a synchronous provision or unprovision takes minutes
            - --upstream-timeout=600s
            - --http-address=0.0.0.0:4180
            - --metrics-address=0.0.0.0:44180
            - --reverse-proxy=true
            - --skip-provider-button=true
            - --cookie-name=_metacatalog_proxy
            - --cookie-secure=true
            - --cookie-expire=8h                  # Keycloak's idle session
            # no tokens in the cookie: Meta Catalog keeps its own session, and
            # tokens would make the Set-Cookie headers too big for the
            # Gateway's nginx (502 at the callback)
            - --session-cookie-minimal=true
            - --silence-ping-logging=true
          envFrom:
            - secretRef:
                name: metacatalog-proxy
          ports:
            - {name: http, containerPort: 4180}
            - {name: metrics, containerPort: 44180}
          readinessProbe:
            httpGet: {path: /ready, port: http}
          livenessProbe:
            httpGet: {path: /ping, port: http}
          resources:
            requests: {cpu: 10m, memory: 32Mi}
            limits: {memory: 128Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
        - name: gate
          image: docker.io/nginxinc/nginx-unprivileged:1.30.5-alpine@sha256:15c994d10d6d78658721c3bcafff14cb281fba2a4bdf9d5ba92c416a472516e3
          resources:
            requests: {cpu: 5m, memory: 16Mi}
            limits: {memory: 64Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: gate, mountPath: /etc/nginx/nginx.conf, subPath: gate.conf, readOnly: true}
            - {name: gate-tmp, mountPath: /tmp}
      volumes:
        - name: gate
          configMap:
            name: metacatalog-gate
        - name: gate-tmp
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: metacatalog-proxy
spec:
  selector:
    app.kubernetes.io/name: metacatalog-proxy
  ports:
    - {name: http, port: 80, targetPort: http}
