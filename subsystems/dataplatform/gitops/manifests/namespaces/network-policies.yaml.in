<%# the pod network's first two octets (site_k3s_cluster_cidr is a /16, one /24 per node) %>
<% set pod = site_k3s_cluster_cidr.split('.')[:2] | join('.') %>
# Ingress policies of the namespaces that hold secrets and state. Pod-to-pod
# traffic from any other namespace is refused unless listed. Traffic from a
# node to a pod on the same node (kubelet probes) is not subject to k3s's
# policy controller, but a node reaching a pod on another node (Ansible
# calling OpenBao or Keycloak from the first k3s server, the certificate job)
# arrives through the overlay from the node's flannel address: those are
# listed (one .0 and one .1 per node's pod CIDR, <%= pod %>.N.0/24). Egress is not
# restricted here.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ingress
  namespace: governance
spec:
  podSelector: {}
  policyTypes: [Ingress]
  ingress:
    - from: [{podSelector: {}}]                                                     # Keycloak, OpenBao, PostgreSQL, iam-sync, the operator, among themselves
    - from:                                                                             # the nodes themselves, through the overlay
<% for n in range(groups['k3s'] | length) %>
        - {ipBlock: {cidr: <%= pod %>.<%= n %>.0/32}}
        - {ipBlock: {cidr: <%= pod %>.<%= n %>.1/32}}
<% endfor %>
        - {ipBlock: {cidr: <%= site_lan_network %>}}
    - from:                                                                             # the Gateway's NGINX pods (in the Gateway's namespace, core; the controller in nginx-gateway): every web UI and the public OIDC endpoints
        - {namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: core}}}
        - {namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: nginx-gateway}}}
    - from: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: operators}}}]       # External Secrets (OpenBao), CloudNativePG (its instances)
    - from: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: observability}}}]   # scrapes
---
# Three doors from compute into governance, each to its own pods only and
# from no wider than it must be. Neither the Hive Metastore nor the Open
# Policy Agent has a login, so who reaches them is what decides:
# - the metastore's Thrift API (9083) and the Agent (8081): Trino's pods
#   only. A pod is Trino's by its label app.kubernetes.io/name, which the
#   admission policy dataplatform-compute-pod-labels lets nobody else carry
#   (manifests/compute/spark/spark-fence.yaml): a Spark job reaches neither;
# - the catalog gate (8080): every pod of compute, that is the Spark jobs
#   (the gate tells them apart and refuses everybody else). The metastore's
#   REST catalog behind it (9001) is reached from governance only (the
#   policy above): by the gate.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: hive-metastore-from-trino
  namespace: governance
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: hive}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: compute}}
          podSelector: {matchLabels: {app.kubernetes.io/name: trino}}
      ports: [{protocol: TCP, port: 9083}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: opa-from-trino
  namespace: governance
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: opa}
  policyTypes: [Ingress]
  ingress:
    - from:
        - namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: compute}}
          podSelector: {matchLabels: {app.kubernetes.io/name: trino}}
      ports: [{protocol: TCP, port: 8081}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: catalog-gate-from-compute
  namespace: governance
spec:
  podSelector:
    matchLabels: {app.kubernetes.io/name: catalog-gate}
  policyTypes: [Ingress]
  ingress:
    - from: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: compute}}}]
      ports: [{protocol: TCP, port: 8080}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ingress
  namespace: observability
spec:
  podSelector: {}
  policyTypes: [Ingress]
  ingress:
    - from: [{podSelector: {}}]                                                     # collectors, aggregator, stores and Grafana among themselves
    - from:                                                                             # the nodes themselves, through the overlay
<% for n in range(groups['k3s'] | length) %>
        - {ipBlock: {cidr: <%= pod %>.<%= n %>.0/32}}
        - {ipBlock: {cidr: <%= pod %>.<%= n %>.1/32}}
<% endfor %>
        - {ipBlock: {cidr: <%= site_lan_network %>}}
    - from:                                                                             # the Gateway's NGINX pods (in core) and its controller: Grafana
        - {namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: core}}}
        - {namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: nginx-gateway}}}
    - from: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: compute}}}]         # the Vector agents of Trino, the Spark history server and the jobs
      ports: [{protocol: TCP, port: 6000}]
    - from: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: governance}}}]      # the Vector agents of the Hive Metastore and the Open Policy Agent
      ports: [{protocol: TCP, port: 6000}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ingress
  namespace: tools
spec:
  podSelector: {}
  policyTypes: [Ingress]
  ingress:
    - from: [{podSelector: {}}]                                                     # the hub, the proxy and the notebooks among themselves (JupyterHub's own policies narrow it)
    - from:                                                                             # the nodes themselves, through the overlay
<% for n in range(groups['k3s'] | length) %>
        - {ipBlock: {cidr: <%= pod %>.<%= n %>.0/32}}
        - {ipBlock: {cidr: <%= pod %>.<%= n %>.1/32}}
<% endfor %>
        - {ipBlock: {cidr: <%= site_lan_network %>}}
    - from:                                                                             # the Gateway's NGINX pods (in core) and its controller: the proxy
        - {namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: core}}}
        - {namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: nginx-gateway}}}
    - from: [{namespaceSelector: {matchLabels: {kubernetes.io/metadata.name: observability}}}]   # scrapes of the hub's metrics
      ports: [{protocol: TCP, port: 8081}]
