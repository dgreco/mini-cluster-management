          },
          "editorMode": "code",
          "expr": "k8s.namespace.name:in($namespace) service.name:in($service) stackable.role:in($role) k8s.pod.name:in($pod) k8s.container.name:in($container) severity_text:in($level) log.collector:in($collector) $search | stats by (k8s.namespace.name, service.name, k8s.pod.name, k8s.container.name, log.collector) count() n | sort by (n desc) | limit 30",
