      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      }
    },
    {
      "type": "table",
      "title": "Top sources",
      "description": "The pods and containers that log most. Click a pod to show only its logs.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${store}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
