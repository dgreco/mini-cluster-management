# The medallion lakehouse model of the data platform, in Meta Catalog's bulk
# format (traits, relationships, entity types, mappings). Loaded once into the
# running Meta Catalog by `make dataplatform-medallion ARGS="load ..."`, which
# skips what is already there. Adapted from Meta Catalog's
# examples/medallion: the same logical shape, physical types that this
# platform provisions for real.
#
# A lakehouse is an aggregate whose parts are its three layers, and each
# layer's parts are its tables. You describe the logical tables; the mappings
# derive the physical resources:
#
#   layer  -> MedallionSchemaType: an Iceberg schema (Trino: lakehouse.<lakehouse>_<layer>)
#             at s3://<%= dataplatform_bucket %>/lakehouse/<lakehouse>/<layer>
#   table  -> MedallionTableType:  an Iceberg table in that schema, at <schema location>/<table>
#
# Both physical types are handled by Meta Catalog's `script` task
# (gitops/manifests/governance/metacatalog/provisioning): provision creates
# them through Trino, unprovision drops them, authorize turns the lakehouse's
# grants into directory grants for Ceph (the record of grants and the STS
# roles; <%= site_admin_group %> only), reject withdraws them. Provisioning goes bronze, silver, gold, each table
# after its schema; unprovisioning the other way round.
#
# Names become SQL identifiers and S3 directories: lower-case letters, digits
# and '_' (the patterns below; the provisioning script checks them again).

Traits:
  # Anything that can sit in the lineage graph: the relationship below lets a
  # silver table depend on a bronze one (`dependsOn` in a lakehouse file).
  - name: LakehouseComponent

  # What every table, whatever its layer, says about itself. The column types
  # are Iceberg's (string, long, int, double, decimal(p,s), date, timestamp,
  # timestamptz, boolean, binary, uuid, ...); the script maps them to Trino's.
  - name: Dataset
    inheritsFrom: LakehouseComponent
    schema:
      type: object
      required: [name, columns]
      properties:
        name:
          type: string
          pattern: "^[a-z][a-z0-9_]{0,62}$"
        description:
          type: string
        columns:
          type: array
          minItems: 1
          items:
            type: object
            required: [name, type]
            properties:
              name:
                type: string
                pattern: "^[a-z_][a-z0-9_]{0,62}$"
              type:
                type: string
              pii:
                type: boolean

---
Relationships:

  - sourceTrait: LakehouseComponent
    relationshipType: IS_REQUIRED_BY
    targetTrait: LakehouseComponent

---
EntityTypes:

  # The aggregate root: provisionable, and the one access policy (Authorizable:
  # principals, permissions, grants) for everything underneath it. Its storage
  # is always a directory of the platform bucket under lakehouse/, the only
  # place Meta Catalog may grant (gitops/iam/access.yaml, metacatalog.prefix).
  - name: LakehouseType
    schema:
      type: object
      required: [name, storageRoot]
      properties:
        name:
          type: string
          pattern: "^[a-z][a-z0-9_]{0,40}$"
        owner:
          type: string
        storageRoot:
          type: string
          pattern: "^s3://<%= dataplatform_bucket | regex_escape %>/lakehouse/[a-z][a-z0-9_]{0,40}$"
    traits:
      - Provisionable
      - Authorizable

  # Three layer types rather than one with a `layer` field: each has its own
  # mapping, and only silver and gold have an upstream layer to reference.
  - name: BronzeLayerType
    schema:
      type: object
      properties:
        name:
          type: string
        retentionDays:
          type: integer
    traits:
      - Aggregate
      - AggregateElement
      - LakehouseComponent

  - name: SilverLayerType
    schema:
      type: object
      properties:
        name:
          type: string
        retentionDays:
          type: integer
    traits:
      - Aggregate
      - AggregateElement
      - LakehouseComponent

  - name: GoldLayerType
    schema:
      type: object
      properties:
        name:
          type: string
        retentionDays:
          type: integer
    traits:
      - Aggregate
      - AggregateElement
      - LakehouseComponent

  # One contract per layer: bronze says where the data comes from, silver
  # promises it is clean, gold names who it is for.
  #
  # The tables carry Aggregate as well as AggregateElement: provisioning
  # collects derived resources from the Aggregate carriers of the tree, so the
  # physical table of a pure leaf would never be provisioned.
  - name: BronzeTableType
    schema:
      type: object
      required: [sourceSystem, ingestion]
      properties:
        sourceSystem:
          type: string
        ingestion:
          type: string
          enum: [batch, streaming, cdc]
    traits:
      - Aggregate
      - AggregateElement
      - Dataset

  - name: SilverTableType
    schema:
      type: object
      required: [primaryKey]
      properties:
        primaryKey:
          type: array
          items:
            type: string
        expectations:
          type: array
          items:
            type: string
    traits:
      - Aggregate
      - AggregateElement
      - Dataset

  - name: GoldTableType
    schema:
      type: object
      required: [businessOwner]
      properties:
        businessOwner:
          type: string
        refresh:
          type: string
    traits:
      - Aggregate
      - AggregateElement
      - Dataset

  # The physical side, derived by the mappings below and never written by
  # hand. Mapped values are strings: `columns` is the logical table's column
  # list as JSON text.
  - name: MedallionSchemaType
    schema:
      type: object
      properties:
        lakehouse:
          type: string
        layer:
          type: string
        namespace:
          type: string
        location:
          type: string
        readsFrom:
          type: string
    traits:
      - ProvisionableResource
      - AuthorizableResource

  - name: MedallionTableType
    schema:
      type: object
      properties:
        lakehouse:
          type: string
        layer:
          type: string
        namespace:
          type: string
        table:
          type: string
        location:
          type: string
        columns:
          type: string
    traits:
      - ProvisionableResource
      - AuthorizableResource

---
Mappings:

  # Layer -> schema. The `upstream` reference of silver and gold lands on the
  # schema of the layer they depend on: bronze is provisioned before silver
  # before gold, and dropped the other way round.
  - sourceEntityType: BronzeLayerType
    targetEntityType: MedallionSchemaType
    mappingValues:
      lakehouse: "#lake.getValue('$.name').asText()"
      layer: "'bronze'"
      namespace: "#lake.getValue('$.name').asText() + '_bronze'"
      location: "#lake.getValue('$.storageRoot').asText() + '/bronze'"
    entityPathReferences:
      - alias: "lake"
        referencePath: "HAS_PART{$}"

  - sourceEntityType: SilverLayerType
    targetEntityType: MedallionSchemaType
    mappingValues:
      lakehouse: "#lake.getValue('$.name').asText()"
      layer: "'silver'"
      namespace: "#lake.getValue('$.name').asText() + '_silver'"
      location: "#lake.getValue('$.storageRoot').asText() + '/silver'"
      readsFrom: "#upstream.getValue('$.namespace').asText()"
    entityPathReferences:
      - alias: "lake"
        referencePath: "HAS_PART{$}"
      - alias: "upstream"
        referencePath: "IS_REQUIRED_BY{$}/MAPPED_TO{$}"

  - sourceEntityType: GoldLayerType
    targetEntityType: MedallionSchemaType
    mappingValues:
      lakehouse: "#lake.getValue('$.name').asText()"
      layer: "'gold'"
      namespace: "#lake.getValue('$.name').asText() + '_gold'"
      location: "#lake.getValue('$.storageRoot').asText() + '/gold'"
      readsFrom: "#upstream.getValue('$.namespace').asText()"
    entityPathReferences:
      - alias: "lake"
        referencePath: "HAS_PART{$}"
      - alias: "upstream"
        referencePath: "IS_REQUIRED_BY{$}/MAPPED_TO{$}"

  # Table -> physical table. `schema` walks up to the table's layer and across
  # to the schema derived from it, so every table is created after its schema
  # and dropped before it.
  - sourceEntityType: BronzeTableType
    targetEntityType: MedallionTableType
    mappingValues:
      lakehouse: "#schema.getValue('$.lakehouse').asText()"
      layer: "'bronze'"
      namespace: "#schema.getValue('$.namespace').asText()"
      table: "#source.getValue('$.name').asText()"
      location: "#schema.getValue('$.location').asText() + '/' + #source.getValue('$.name').asText()"
      columns: "#source.getValue('$.columns').toString()"
    entityPathReferences:
      - alias: "schema"
        referencePath: "HAS_PART{$}/MAPPED_TO{$}"

  - sourceEntityType: SilverTableType
    targetEntityType: MedallionTableType
    mappingValues:
      lakehouse: "#schema.getValue('$.lakehouse').asText()"
      layer: "'silver'"
      namespace: "#schema.getValue('$.namespace').asText()"
      table: "#source.getValue('$.name').asText()"
      location: "#schema.getValue('$.location').asText() + '/' + #source.getValue('$.name').asText()"
      columns: "#source.getValue('$.columns').toString()"
    entityPathReferences:
      - alias: "schema"
        referencePath: "HAS_PART{$}/MAPPED_TO{$}"

  - sourceEntityType: GoldTableType
    targetEntityType: MedallionTableType
    mappingValues:
      lakehouse: "#schema.getValue('$.lakehouse').asText()"
      layer: "'gold'"
      namespace: "#schema.getValue('$.namespace').asText()"
      table: "#source.getValue('$.name').asText()"
      location: "#schema.getValue('$.location').asText() + '/' + #source.getValue('$.name').asText()"
      columns: "#source.getValue('$.columns').toString()"
    entityPathReferences:
      - alias: "schema"
        referencePath: "HAS_PART{$}/MAPPED_TO{$}"
