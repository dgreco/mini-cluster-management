# Managed by Ansible (subsystems/k3s/roles/k3s_ceph_csi). Installed by the k3s
# Helm controller; edit group_vars/k3s.yml and re-run make k3s-storage instead.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: ceph-csi-rbd
  namespace: kube-system
spec:
  repo: {{ k3s_ceph_csi_chart_repo }}
  chart: ceph-csi-rbd
  version: {{ k3s_ceph_csi_version }}
  targetNamespace: ceph-csi-rbd
  createNamespace: true
  valuesContent: |-
    csiConfig:
      - clusterID: "{{ _ceph.k3s_ceph_fsid }}"
        monitors: {{ _ceph.k3s_ceph_monitors | to_json }}
    secret:
      create: true
      name: csi-rbd-secret
      userID: {{ k3s_ceph_rbd_user }}
      userKey: {{ _ceph.k3s_ceph_rbd_key }}
    storageClass:
      create: true
      name: {{ k3s_rbd_storage_class }}
      annotations:
        storageclass.kubernetes.io/is-default-class: "{{ (k3s_default_storage_class == k3s_rbd_storage_class) | lower }}"
      clusterID: "{{ _ceph.k3s_ceph_fsid }}"
      pool: {{ k3s_ceph_rbd_pool }}
      imageFeatures: {{ k3s_ceph_rbd_image_features }}
      reclaimPolicy: Delete
      allowVolumeExpansion: true
